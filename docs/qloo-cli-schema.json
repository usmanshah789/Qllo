{
  "name": "qloo",
  "version": "1.0.0",
  "commands": [
    {
      "name": "insights",
      "description": "Get taste-based insights and recommendations",
      "options": [
        {
          "flag": "--type",
          "short": "-t",
          "description": "Entity type URN or alias (see Entity Types below)",
          "required": true,
          "type": "string"
        },
        {
          "flag": "--signal-entities",
          "short": "-s",
          "description": "Comma-separated entity IDs or URNs to use as interest signals",
          "required": false,
          "type": "string"
        },
        {
          "flag": "--signal-query",
          "description": "Search for an entity by name and use the top result as a signal (e.g. 'Breaking Bad')",
          "required": false,
          "type": "string"
        },
        {
          "flag": "--signal-query-type",
          "description": "Entity type to scope the --signal-query search (see Entity Types below)",
          "required": false,
          "type": "string"
        },
        {
          "flag": "--signal-tags",
          "description": "Comma-separated tag URNs to use as interest signals",
          "required": false,
          "type": "string"
        },
        {
          "flag": "--for",
          "description": "Natural language taste description (e.g. 'Breaking Bad fans who love craft beer')",
          "required": false,
          "type": "string"
        },
        {
          "flag": "--filter-tags",
          "description": "Comma-separated tag URNs to filter results",
          "required": false,
          "type": "string"
        },
        {
          "flag": "--filter-location",
          "description": "Filter results by location query",
          "required": false,
          "type": "string"
        },
        {
          "flag": "--signal-location",
          "description": "Use location as a signal for personalization",
          "required": false,
          "type": "string"
        },
        {
          "flag": "--signal-entities-weight",
          "description": "Weight for entity signals (0-1)",
          "required": false,
          "type": "string"
        },
        {
          "flag": "--signal-tags-weight",
          "description": "Weight for tag signals (0-1)",
          "required": false,
          "type": "string"
        },
        {
          "flag": "--signal-location-weight",
          "description": "Weight for location signal (0-1)",
          "required": false,
          "type": "string"
        },
        {
          "flag": "--take",
          "short": "-n",
          "description": "Number of results to return",
          "required": false,
          "type": "string",
          "defaultValue": "10"
        },
        {
          "flag": "--page",
          "short": "-p",
          "description": "Page number (1-indexed)",
          "required": false,
          "type": "string"
        },
        {
          "flag": "--offset",
          "description": "Offset for pagination",
          "required": false,
          "type": "string"
        },
        {
          "flag": "--json",
          "short": "-j",
          "description": "Output as JSON",
          "required": false,
          "type": "boolean"
        },
        {
          "flag": "--plain",
          "description": "Output as TSV",
          "required": false,
          "type": "boolean"
        },
        {
          "flag": "--fields",
          "description": "Comma-separated fields to include in output",
          "required": false,
          "type": "string"
        },
        {
          "flag": "--dry-run",
          "description": "Show request details without calling the API",
          "required": false,
          "type": "boolean"
        },
        {
          "flag": "--params",
          "description": "Raw JSON params to merge with flags",
          "required": false,
          "type": "string"
        }
      ],
      "arguments": []
    },
