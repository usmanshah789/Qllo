# Qloo hackathon API
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TRUSTED_BASE_URL=https://hackathon.api.qloo.com
QLOO_API_KEY=

# auto = mock while QLOO_API_KEY is empty, live once it is filled in
QLOO_MOCK_MODE=auto

# LLM used as the agent brain (needed from Stage 4 on)
ANTHROPIC_API_KEY=

# Groq (OpenAI-compatible). Used when ANTHROPIC_API_KEY is empty.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
